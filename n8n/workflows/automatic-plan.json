        "jsCode": "// HTTP Request entrega un item por espacio; no usar la 'situacion': pendiente cuenta como físicamente vacío.\nconst espacios = $input.all().flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\nreturn espacios.length > 0 && espacios.every(espacio => espacio.estado === 'libre') ? [{ json: { espacios_libres: espacios.length } }] : [];"
