# Config del nodo ESP32 (local, NO versionar). Ver README.
# Se genera src/config.h con: python setup_config.py

# WiFi (simulación: Wokwi-GUEST sin contraseña)
WIFI_SSID=Wokwi-GUEST
WIFI_PASS=

# Base de la API (SIN barra final).

API_BASE_URL=http://127.0.0.1:9/

# Validación TLS: 1 = estricta (bundle ISRG, cadena X1 propia),
# 0 = flexible (cifrado sin validar; SOLO dev/sim, nunca prod pública).
TLS_VERIFICAR=0/
