POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_luben

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/smart_luben

CORS_ORIGINS=["http://localhost:4200"]
DEBUG=true

DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Garage S3 (objetos: modelos 3D e imágenes de productos).
# S3_ACCESS_KEY debe empezar con GK (ej: GK + openssl rand -hex 16).
# Generar secretos una vez y reutilizar los mismos en backend y garage.
S3_ACCESS_KEY=GKtu_clave_aqui
S3_SECRET_KEY=tu_secreto_aqui
# Endpoint interno para el backend (nombre del servicio en compose)
S3_ENDPOINT=http://garage:3900
# Endpoint S3 visto desde navegador/AR (firma de presigned PUT/GET).
# Solo esquema+host (nginx preserva el path /<bucket>/... sin recortes, la
# firma SigV4 lo exige). Dev PC: http://localhost | Dev móvil: http://TU_IP_LAN
# Prod: https://tu-dominio (nginx /smart-luben/ -> garage, con CORS resuelto ahí).
S3_PUBLIC_ENDPOINT=http://localhost

# n8n: misma URL pública que el frontend, bajo /n8n/ (terminar en /).
# En producción usar la URL HTTPS REAL, por ejemplo https://tu-dominio/n8n/
N8N_PUBLIC_URL=http://localhost/n8n/
# Generar con: openssl rand -hex 32. Conservar la misma clave al reiniciar/restaurar.
N8N_ENCRYPTION_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA
# Activar solo al publicar el workflow con webhook de n8n. URL INTERNA del
# contenedor (sin /n8n/; ese prefijo lo añade nginx solo para el navegador).
N8N_EMPTY_COUNTER_WEBHOOK_URL=http://n8n:5678/webhook/smart-luben-espacio-liberado
