    {
      "parameters": {
        "jsCode": "const inicio = 8 * 60;  // 08:00 America/Lima\nconst fin = 22 * 60;    // 22:00 America/Lima\nconst partes = new Intl.DateTimeFormat('en-GB', { timeZone: 'America/Lima', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());\nconst hora = Number(partes.find(p => p.type === 'hour').value);\nconst minuto = Number(partes.find(p => p.type === 'minute').value);\nconst dentroDeHorario = hora * 60 + minuto >= inicio && hora * 60 + minuto < fin;\nreturn dentroDeHorario ? $input.all().filter(item => item.json.body?.event === 'space_released') : [];"
      },
      "id": "a5dccbb2-d0f3-49ce-8f4f-8ee692d78c64",
