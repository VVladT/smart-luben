# Config del nodo ESP32 (local, NO versionar). Ver README.
# Se genera src/config.h con: python setup_config.py

# WiFi (simulación: Wokwi-GUEST sin contraseña)
WIFI_SSID=Wokwi-GUEST
WIFI_PASS=

# Base de la API (SIN barra final).
# Por seguridad los tests apuntan a un blackhole: la sim verifica detección,
# NUNCA escribe en una API real. Solo para E2E manual, apuntar al backend:
#   Dev Wokwi: http://host.wokwi.internal:8000
#   Prod: https://tu-ngrok.ngrok-free.dev
API_BASE_URL=http://127.0.0.1:9/
