# ============================================================
# Environment
# ============================================================

.env
.env.*
!.env.example


# ============================================================
# Python / Backend
# ============================================================

# Virtual environments
backend/venv/
backend/.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Build / distribution
backend/build/
backend/dist/
backend/*.egg-info/

# ML model artifacts (se re-entrenan en cada deploy, no versionar)
backend/models/*.pkl
backend/models/*_meta.json

# Local Python tooling
.python-version


